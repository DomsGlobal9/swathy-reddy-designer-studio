# Where this page reads the boutique's pieces and collections from (read-only, no key needed),
# and where its buttons send shoppers. The defaults already point at the live shop; set these
# only to point the page at a different shop or a test server.
VITE_SHOP_SLUG=swathy-reddy-designer-studio
VITE_SHOP_URL=https://shop.scaleezy.com/swathy-reddy-designer-studio
VITE_SHOP_API=https://inventory-backend-1-ym8d.onrender.com/shop/swathy-reddy-designer-studio

# Scaleezy Boutique CRM — Customer Portal API:
# Obtain these from Scaleezy Superadmin -> All Boutiques -> Overview -> "Access - Customer Portal API"
# VITE_SCALEEZY_BASE_URL: The Django backend origin (e.g. https://crm-backend.scaleezy.com, without /api)
# VITE_SCALEEZY_PORTAL_KEY: The Portal API key (format: <key_id>.<secret>)
VITE_SCALEEZY_BASE_URL=
VITE_SCALEEZY_PORTAL_KEY=

# EmailJS appointment booking configuration:
# 1. Sign up / Log in at https://dashboard.emailjs.com/
# 2. Add an Email Service (e.g. Gmail) -> Copy "Service ID"
# 3. Create an Email Template -> Copy "Template ID"
#    Variables available in template: {{name}}, {{phone}}, {{email}}, {{occasion}}, {{date}}, {{formatted_date}}, {{mode}}, {{notes}}, {{message}}, {{dress_type}}, {{dress_summary}}, {{measurements_summary}}
# 4. In Account > API Keys -> Copy "Public Key"
VITE_BOUTIQUE_EMAIL=label.swathyreddy12@gmail.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
